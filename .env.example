# Copy to .env.local and fill in. Only PUBLIC values belong here: they are baked into the static site.
# Never put a Clerk secret key (sk_...) in this project; the app refuses it anyway (ADR 0008).

# Clerk publishable key (Dashboard → API keys). Leave empty to run with accounts off: everything free, ads as now.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Slug of the Clerk Billing user plan that means Premium (default: premium).
NEXT_PUBLIC_PREMIUM_PLAN=premium

# Optional: the plan's id (cplan_...) to skip looking it up by slug before checkout.
NEXT_PUBLIC_CLERK_PREMIUM_PLAN_ID=

# The site's public origin, for canonical URLs, hreflang, sitemap.xml and robots.txt (change 0025).
# Set it once hosting is decided (change 0002); without it a placeholder origin is used.
NEXT_PUBLIC_SITE_URL=
